{
  "name": "tubescribe-reader",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build:reader": "node scripts/build-reader.mjs",
    "check:reader": "node scripts/build-reader.mjs --check",
    "test:reader": "node --test tests/*.test.mjs",
