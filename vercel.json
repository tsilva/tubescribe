{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm exec --yes --ignore-scripts --package=pnpm@10.33.0 -- pnpm install --frozen-lockfile --ignore-scripts --prod=false && node scripts/stage-clerk-ui.mjs",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "clerk-ui-build/**",
      "excludeFiles": "{data/**,models/**,tests/**,scripts/**,node_modules/**,src/reader/**,.agents/**,.github/**,.env*,compose*.yaml,Dockerfile,uv.lock}"
    }
  },
  "rewrites": [
    {
      "source": "/api/live",
      "destination": "/api/realtime"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "0 8 * * *"
    }
  ],
  "framework": "python",
  "fluid": true
}
